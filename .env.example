# VETMO — пример конфигурации окружения
# Скопируйте в .env и заполните при необходимости. Секреты НЕ коммитить.
# Все переменные читаются с префиксом VETMO_ (pydantic-settings).

# --- Приложение (anon-ключ Supabase, читается в exe) ---
# Опционально: Supabase (без них приложение работает офлайн)
VETMO_SUPABASE_URL=
VETMO_SUPABASE_KEY=

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
VETMO_LOG_LEVEL=INFO

# --- Sync-скрипт (только %APPDATA%\VETMO\secrets.env, НЕ в exe) ---
# service_role для записи в Supabase (sync-скрипт)
VETMO_SYNC_SUPABASE_URL=
VETMO_SYNC_SERVICE_KEY=
# STRATZ GraphQL токен (контрпики, синергия, баны)
VETMO_SYNC_STRATZ_TOKEN=
VETMO_SYNC_STRATZ_API_URL=https://api.stratz.com/graphql

# OpenDota — публичный REST API, токен не требуется.
# Может использоваться как в sync-скрипте, так и в пользовательском приложении.
VETMO_SYNC_OPENDOTA_BASE_URL=https://api.opendota.com/api/
VETMO_SYNC_OPENDOTA_RATE_LIMIT_PER_MIN=60
VETMO_SYNC_OPENDOTA_CACHE_TTL_HOURS=24.0
