# VETMO — пример конфигурации окружения
# Скопируйте в .env и заполните при необходимости. Секреты НЕ коммитить.
# Все переменные читаются с префиксом VETMO_ (pydantic-settings).

# Опционально: Supabase (без них приложение работает офлайн)
VETMO_SUPABASE_URL=
VETMO_SUPABASE_KEY=

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
VETMO_LOG_LEVEL=INFO
